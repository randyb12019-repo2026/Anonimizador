```gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Distribución / empaquetado
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Instaladores
pip-log.txt
pip-delete-this-directory.txt

# Cobertura y testing
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# Archivos de entorno
.env
.env.*

# VS Code
.vscode/

# PyCharm
.idea/

# Logs
*.log

# Sistema operativo
.DS_Store
Thumbs.db

# MyPy
.mypy_cache/

# Ruff
.ruff_cache/

# Pyre
.pyre/

# Archivos temporales
*.tmp
*.temp
```